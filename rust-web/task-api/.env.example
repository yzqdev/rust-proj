# 复制为 .env 后按需修改：cp .env.example .env
# 监听地址
APP_HOST=127.0.0.1
APP_PORT=8080

# SQLite 数据库。相对路径相对于启动目录，父目录会自动创建。
DATABASE_URL=sqlite://data/app.db
DB_MAX_CONNECTIONS=5

# 静态文件目录（内页前端）。留空表示不提供页面。
STATIC_DIR=static

# 是否允许任意来源的跨域请求；生产环境应改为 false 并自行收窄。
CORS_PERMISSIVE=true

# 日志级别
RUST_LOG=info,rust_web=debug,tower_http=debug
